{
  "name": "hataraku",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:mobile": "turbo run build:mobile --filter=@hataraku/mobile",
    "dev:mobile": "turbo run start --filter=@hataraku/mobile",
    "typegen": "turbo run typegen",
    "test:e2e": "turbo run test:e2e",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:studio": "turbo run db:studio",
    "check": "vp check",
    "check:design": "node scripts/check-design.mjs",
    "test": "vp test",
    "knip": "knip",
    "ready": "turbo run typegen && vp check && knip && vp test && turbo run test:e2e && turbo run build",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@hataraku/config": "workspace:*",
    "@shadcn/lint": "catalog:",
    "@types/node": "catalog:",
    "knip": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": "24.22.0",
    "pnpm": "12.14.0"
  },
  "packageManager": "pnpm@12.14.0"
}
