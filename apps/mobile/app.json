{
  "expo": {
    "name": "hataraku",
    "slug": "hataraku",
    "scheme": "hataraku",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android"],
    "ios": {
      "bundleIdentifier": "com.hataraku.app"
    },
    "android": {
      "package": "com.hataraku.app"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
