### Ran Playwright code
```js
await (async (page) => {
  await page.bringToFront();
  await page.setViewportSize({ width: Math.round(1440 * 0.9), height: 900 });
  await page.goto('http://localhost:3000/blog', { waitUntil: 'networkidle' });
  await page.evaluate(() => localStorage.setItem('theme', 'light'));
  await page.reload({ waitUntil: 'networkidle' });
  const measure = async (path) => {
    await page.goto('http://localhost:3000' + path, { waitUntil: 'networkidle' });
    await page.waitForTimeout(300);
    return await page.evaluate(() => {
      const bar = document.querySelector('nav[aria-label="主导航"]');
      const items = [...bar.querySelectorAll('li')].map((li) => ({ text: (li.textContent || '').trim(), current: !!li.querySelector('[aria-current="page"]') }));
      const current = [...bar.querySelectorAll('[aria-current="page"]')].map((el) => (el.textContent || '').trim());
      return { items, current, docsVisible: items.some((i) => i.text === '文档'), writingVisible: items.some((i) => i.text === '写作') };
    });
  };
  const blog = await measure('/blog');
  const docs = await measure('/docs');
  const archive = await measure('/blog/archive');
  const taxonomy = await measure('/blog/taxonomy');
  return { blog, docs, archive, taxonomy };
})(page);
```
