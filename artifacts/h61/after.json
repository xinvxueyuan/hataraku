await (async (page) => {
  await page.bringToFront();
  await page.setViewportSize({ width: Math.round(1440 * 0.9), height: 900 });
  await page.goto('http://localhost:3000/', { waitUntil: 'networkidle' });
  await page.evaluate(() => localStorage.setItem('theme', 'light'));
  await page.reload({ waitUntil: 'networkidle' });
  const metrics = async (path, selectors) => {
    await page.goto('http://localhost:3000' + path, { waitUntil: 'networkidle' });
    await page.waitForTimeout(400);
    return await page.evaluate((sels) => {
      const out = {};
      for (const [name, sel] of Object.entries(sels)) {
        const el = document.querySelector(sel);
        if (!el) { out[name] = null; continue; }
        const cs = getComputedStyle(el);
        out[name] = { text: (el.textContent || '').trim().slice(0, 18), fontSize: cs.fontSize, lineHeight: cs.lineHeight, ratio: Number((parseFloat(cs.lineHeight) / parseFloat(cs.fontSize)).toFixed(3)), height: Math.round(el.getBoundingClientRect().height) };
      }
      return out;
    }, selectors);
  };
  const home = await metrics('/', { h1: 'h1', section: 'h2', lead: '[data-slot="latest-list"] li span span', second: '[data-slot="latest-list"] li:nth-child(2) span span' });
  const article = await metrics('/article', { h1: 'h1', lead: '[data-slot="article-list"] li:first-child a', second: '[data-slot="article-list"] li:nth-child(2) a' });
  const post = await metrics('/posts/2026-10-17-google-ai-studio-personal-android-apps', { h1: 'h1', h2: '[data-slot="post-body"] h2' });
  await page.setViewportSize({ width: Math.round(390 * 0.9), height: 844 });
  const homeMobile = await metrics('/', { h1: 'h1', section: 'h2', lead: '[data-slot="latest-list"] li span span' });
  return { home, article, post, homeMobile };
})(page);
