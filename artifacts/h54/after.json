await (async (page) => {
  await page.bringToFront();
  await page.evaluate(() => localStorage.setItem('theme', 'light'));
  await page.setViewportSize({ width: Math.round(1440 * 0.9), height: 900 });
  const fingerprints = {};
  await page.goto('http://localhost:3000/', { waitUntil: 'networkidle' });
  await page.waitForTimeout(500);
  fingerprints.home = await page.evaluate(() => ({
    themeButton: document.querySelector('header button[aria-label="Toggle theme"]')?.getAttribute('aria-label') ?? null,
    theme: document.documentElement.className,
    dates: [...document.querySelectorAll('time')].slice(0, 3).map((t) => t.textContent),
    headerLinkRadius: getComputedStyle(document.querySelector('header a')).borderRadius,
  }));
  await page.goto('http://localhost:3000/article', { waitUntil: 'networkidle' });
  await page.waitForTimeout(400);
  fingerprints.pager = await page.evaluate(() => {
    const navs = [...document.querySelectorAll('nav')].filter((n) => n.querySelector('[aria-disabled="true"], a[href*="page="]'));
    const nav = navs.at(-1);
    return nav === undefined ? null : { label: nav.getAttribute('aria-label'), text: (nav.innerText || '').replace(/\s+/g, ' '), links: [...nav.querySelectorAll('a')].map((a) => a.getAttribute('href')), disabled: [...nav.querySelectorAll('[aria-disabled="true"]')].map((e) => e.textContent) };
  });
  await page.keyboard.press('Tab');
  await page.keyboard.press('Tab');
  await page.waitForTimeout(200);
  fingerprints.focus = await page.evaluate(() => {
    const el = document.activeElement;
    const cs = getComputedStyle(el);
    return { tag: el.tagName, text: (el.textContent || '').slice(0, 20), boxShadow: cs.boxShadow, outline: cs.outlineStyle, radius: cs.borderRadius };
  });
  await page.goto('http://localhost:3000/docs/authoring', { waitUntil: 'networkidle' });
  await page.waitForTimeout(500);
  fingerprints.docs = await page.evaluate(() => ({
    tocLabel: document.querySelector('nav[aria-label="本页目录"]')?.getAttribute('aria-label') ?? null,
    tocLinks: [...document.querySelectorAll('nav[aria-label="本页目录"] a')].map((a) => a.getAttribute('href')),
    admonitions: [...document.querySelectorAll('[data-admonition]')].map((e) => e.getAttribute('data-admonition')),
    codeButtons: [...document.querySelectorAll('[data-slot="code-block"] button')].map((b) => b.getAttribute('aria-label')),
  }));
  const copy = page.getByRole('button', { name: '复制代码' }).first();
  if (await copy.count()) { await copy.click(); await page.waitForTimeout(300); fingerprints.copy = { label: await copy.getAttribute('aria-label'), status: await page.locator('[data-slot="code-block"] output').first().textContent() }; }
  return fingerprints;
})(page);
