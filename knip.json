{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["artifacts/**"],
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.ts"],
      "ignoreDependencies": ["postgres"]
    },
    "apps/mobile": {
      "ignoreDependencies": ["expo-updates"]
    },
    "packages/ui": {
      "entry": ["src/icons.ts"]
    },
    "apps/web": {
      "entry": [
        "e2e.config.ts",
        "velite.config.ts",
        "tests/e2e/**/*.e2e.ts",
        "tests/support/start.ts"
      ]
    }
  }
}
